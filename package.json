{
  "name": "tokenmate",
  "version": "0.1.0",
  "description": "Play, watch and analyse chess against any AI model — in your terminal.",
  "type": "module",
  "bin": { "tokenmate": "./src/cli.ts" },
  "engines": { "bun": ">=1.4.0" },
  "license": "MIT",
  "keywords": ["chess", "tui", "bun", "llm", "opentui", "stockfish", "models-dev", "cli"],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "build": "bun build src/cli.ts --target bun --outdir dist --minify",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "check:contrast": "bun test test/contrast.test.ts",
    "check:layout": "bun test test/layout.test.ts",
    "check:licences": "bun run scripts/check-licences.ts",
    "check:licences:strict": "bun run scripts/check-licences.ts --strict",
    "board": "bun run scripts/render-board.ts",
    "check": "bun run lint && bun test && bun run check:licences"
  },
  "dependencies": {
    "@opentui/core": "0.9.7",
    "chess.js": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
